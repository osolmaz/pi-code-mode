{
  "name": "pi-code-mode",
  "version": "0.3.0",
  "description": "Run OpenAI-shaped Code Mode in Pi through an isolated V8 host.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osolmaz/pi-code-mode.git"
  },
  "homepage": "https://github.com/osolmaz/pi-code-mode#readme",
  "bugs": "https://github.com/osolmaz/pi-code-mode/issues",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-code-mode": "dist/harness/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "scripts": {
    "clean": "rm -rf coverage dist",
    "build": "npm run clean && npm run build:host && npm run build:ts",
    "build:host": "node scripts/build-host.mjs",
    "build:ts": "tsc --project tsconfig.build.json",
    "postbuild": "node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/harness/cli.js', 0o755)\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --config eslint.config.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "coverage": "npm run build && vitest run --coverage --config vitest.config.ts",
    "dry": "slophammer-ts dry .",
    "mutate": "stryker run stryker.config.mjs",
    "slophammer": "slophammer-ts check .",
    "simpledoc": "simpledoc check",
    "rust:format": "cargo fmt --manifest-path runtime/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path runtime/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path runtime/Cargo.toml --workspace",
    "check": "npm run format && npm run lint && npm run typecheck && npm run rust:format && npm run rust:lint && npm run rust:test && npm run test && npm run coverage && npm run dry && npm run simpledoc",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@eslint/js": "9.39.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "slophammer-ts": "0.5.0",
    "@simpledoc/simpledoc": "0.1.6",
    "typebox": "1.3.22",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "3.2.7"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
